# 이 파일을 .env 로 복사한 뒤 본인 키를 채우세요 (.env 는 절대 공유 금지).
# 키가 없어도 실습은 됩니다 — 미리 저장된 응답(data/api_cache.json)으로 오프라인 진행됩니다.
# 키가 있으면 실제 OpenAI 응답을 받아 볼 수 있습니다.
OPENAI_API_KEY=
# 선택: OpenAI가 한도·시간 초과로 실패하면 Claude Haiku가 대신 답합니다(src/resources.py)
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
LLAMA_CLOUD_API_KEY = 

# Supabase 대시보드 → Project Settings → API 의 Project URL 과 anon public 키
SUPABASE_URL=
SUPABASE_ANON_KEY=