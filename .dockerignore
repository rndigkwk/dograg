# Secrets: passed to the container at run time (Secret Manager / --env-file), never baked in.
.env
.env.*
.streamlit/secrets.toml
*.key
*.pem

# Local environments and outputs
.venv/
.uv-cache/
**/__pycache__/
output/
.playwright-mcp/
.omc/
.claude/
.git/
.github/
.ruff_cache/
.cache/

